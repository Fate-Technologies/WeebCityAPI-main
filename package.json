{
  "name": "@tatakai/api-v3",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Tatakai V6 catalog API — AniList/Jikan metadata, extensions manifests, telemetry. No scraping.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db": "tsx scripts/db.ts",
    "import": "tsx scripts/import.ts",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:manga": "tsx scripts/scrape.ts --type MANGA",
    "scrape:anime": "tsx scripts/scrape.ts --type ANIME",
    "refresh": "tsx scripts/refresh.ts",
    "job:ingest": "tsx src/jobs/ingestionWorker.ts",
    "job:feeds": "tsx src/jobs/contentRefresh.ts",
    "job:mappings": "tsx src/jobs/mappingsRefresh.ts",
    "job:news": "tsx src/jobs/newsRefresh.ts",
    "job:news-bootstrap": "tsx src/jobs/newsBotBootstrap.ts",
    "job:airing": "tsx src/jobs/airingReminders.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.2",
    "@pothos/core": "^4.3.0",
    "@prisma/client": "^6.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.7.9",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0",
    "dataloader": "^2.2.3",
    "dotenv": "^16.5.0",
    "envalid": "^8.0.0",
    "graphql": "^16.10.0",
    "he": "^1.2.0",
    "hono": "^4.7.10",
    "ioredis": "^5.6.1",
    "ipaddr.js": "2.2.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "rss-parser": "^3.13.0",
    "satori": "^0.12.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^22.15.21",
    "csv-parse": "^5.6.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
